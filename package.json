{
  "name": "chess-doubles",
  "version": "1.0.0",
  "description": "Chess Doubles web app with AWS Lambda backend",
  "type": "module",
  "scripts": {
    "dev": "npm run build:backend && nodemon --watch src --ext ts --exec \"npm run build:backend && node dist/src/server.js\"",
    "dev:frontend": "node esbuild.config.js",
    "build": "npm run build:backend && npm run build:frontend && npm run build:css",
    "build:backend": "tsc",
    "build:frontend": "node esbuild.config.js",
    "build:css": "tailwindcss -i frontend/src/styles/input.css -o dist/public/app.css",
    "build:css:watch": "tailwindcss -i frontend/src/styles/input.css -o dist/public/app.css --watch",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.frontend.json --noEmit",
    "migrate": "npm run build:backend && knex --knexfile dist/knexfile.js migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "npm run build:backend && knex --knexfile dist/knexfile.js migrate:rollback",
    "seed": "npm run build:backend && knex --knexfile dist/knexfile.js seed:run",
    "seed:make": "knex seed:make",
    "test": "npm run build:backend && jest",
    "test:watch": "npm run build:backend && jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@middy/core": "^5.0.0",
    "@middy/http-cors": "^5.0.0",
    "@middy/http-error-handler": "^5.0.0",
    "@middy/http-json-body-parser": "^5.0.0",
    "@middy/input-output-logger": "^5.0.0",
    "@middy/validator": "^5.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mime": "^4.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@types/aws-lambda": "^8.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.0.0",
    "esbuild": "^0.20.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "serve": "^14.2.5",
    "ts-jest": "^29.4.3",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
